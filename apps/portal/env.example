# Copiar a .env.local y completar valores locales — NUNCA commitear .env* (regla git-safety / DEI).
# Nota: este archivo se llama "env.example" (sin punto inicial) porque los archivos ".env*"
# están bloqueados por permisos de escritura del agente (protección anti-secrets), mismo
# criterio que apps/api/env.example.

# Base de la API pública (apps/api). Sin definir, cae a http://localhost:3000/v1 (src/lib/http-client.ts).
NEXT_PUBLIC_API_URL=http://localhost:3000/v1

# reCAPTCHA v3 invisible (ADR-007, spec-portal-detalle CU-002). Clave del SITIO (pública) —
# la clave SECRETA vive solo en apps/api (RECAPTCHA_SECRET_KEY, nunca en el frontend).
# Sin definir: el botón "Contactar por WhatsApp" queda deshabilitado con el mensaje de RN-003
# (degradación esperada, no un bug) — ver src/lib/recaptcha.ts.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google Maps Embed API (ADR-011, spec-portal-detalle CU-001 HU-001). Clave pública restringida
# por dominio/HTTP referrer en la consola de Google Cloud — el mapa siempre muestra la zona
# aproximada, nunca la dirección exacta (ADR-011). Sin definir: el bloque de mapa degrada a
# texto (ciudad/barrio) — ver src/lib/maps.ts.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
