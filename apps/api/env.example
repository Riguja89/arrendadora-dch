# Copiar a .env y completar valores locales — NUNCA commitear .env (regla git-safety / DEI).
# Nota: este archivo se llama "env.example" (sin punto inicial) porque los archivos ".env*"
# están bloqueados por permisos de escritura del agente (protección anti-secrets).

# Puerto HTTP de la API
PORT=3000

# Cadena de conexión PostgreSQL (ADR-003)
DATABASE_URL="postgresql://arrendadora:arrendadora@localhost:5432/arrendadora?schema=public"

# Entorno de ejecución
NODE_ENV=development

# Base del panel administrativo — usada para construir el enlace de recuperación de contraseña
# (RN-019, auth-usuarios). Debe apuntar al SPA React del panel (ADR-004).
PANEL_URL=http://localhost:5173

# Seed del primer Administrador (RN-035 excepción) — usado solo por `prisma/seed.ts`.
# Cambiar SEED_ADMIN_PASSWORD antes de sembrar cualquier ambiente real.
SEED_ADMIN_EMAIL=admin@arrendadora.local
SEED_ADMIN_PASSWORD=Cambiar123
