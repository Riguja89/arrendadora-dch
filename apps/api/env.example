# Copiar a .env y completar valores locales — NUNCA commitear .env (regla git-safety / DEI).
# Nota: este archivo se llama "env.example" (sin punto inicial) porque los archivos ".env*"
# están bloqueados por permisos de escritura del agente (protección anti-secrets).

# Puerto HTTP de la API
PORT=3000

# Cadena de conexión PostgreSQL (ADR-003)
DATABASE_URL="postgresql://arrendadora:arrendadora@localhost:5432/arrendadora?schema=public"

# Entorno de ejecución
NODE_ENV=development

# Base del panel administrativo — usada para construir el enlace de recuperación de contraseña
# (RN-019, auth-usuarios). Debe apuntar al SPA React del panel (ADR-004).
PANEL_URL=http://localhost:5173

# Base del SPA del portal público — usada para el og:url canónico de la ficha de detalle
# (ADR-010, portal-detalle). Debe apuntar al portal público (distinto del panel admin).
PORTAL_URL=http://localhost:5174

# Anti-bot del contacto por WhatsApp (ADR-007, portal-detalle). driver=stub aprueba siempre (dev/
# tests, sin credenciales); driver=recaptcha verifica el token de reCAPTCHA v3 contra Google.
# La CLAVE SECRETA reCAPTCHA NUNCA se commitea: va por variable de entorno (dejar vacía en el repo).
ANTIBOT_DRIVER=stub
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_MIN=0.5
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
# Timeout (ms) del fetch a siteverify. Sin esto, una red móvil lenta puede colgar la request hasta
# el timeout del socket del OS (~2 min) antes de caer en fail-closed (ADR-007). Default generoso
# para redes móviles lentas sin colgar la request del usuario.
RECAPTCHA_VERIFY_TIMEOUT_MS=7000

# Multimedia / almacenamiento de fotos (ADR-008). driver=local usa un adaptador de dev sin
# proveedor real (no sube a ningún bucket); driver=s3 usa el adaptador S3 (LocalStack en dev,
# S3+CloudFront real en producción). Las credenciales AWS reales NUNCA se commitean: van por
# variables de entorno / IAM role. Los valores de abajo son los defaults de DEV contra LocalStack
# (bucket ya provisionado localmente) — sobreescribir en producción.
MULTIMEDIA_STORAGE_DRIVER=local
MULTIMEDIA_CDN_BASE_URL=http://localhost:3000/media
AWS_S3_BUCKET=arrendadora-multimedia-dev
AWS_REGION=us-east-1
# Endpoint S3-compatible — LocalStack en dev; vacío en producción (AWS SDK resuelve el endpoint
# estándar por región). AWS_S3_FORCE_PATH_STYLE=true es requerido por LocalStack/MinIO.
AWS_S3_ENDPOINT=http://localhost:4566
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Geocodificación de direcciones (ADR-011, RN-033, admin-propiedades). driver=stub devuelve
# coordenadas determinísticas (dev/tests, sin credenciales); driver=google geocodifica contra
# Google Geocoding API. La API KEY real NUNCA se commitea: va por variable de entorno, restringida
# por IP en la consola de Google Cloud.
GEOCODING_DRIVER=stub
GOOGLE_GEOCODING_API_KEY=
GEOCODING_URL=https://maps.googleapis.com/maps/api/geocode/json

# Seed del primer Administrador (RN-035 excepción) — usado solo por `prisma/seed.ts`.
# Cambiar SEED_ADMIN_PASSWORD antes de sembrar cualquier ambiente real.
SEED_ADMIN_EMAIL=admin@arrendadora.local
SEED_ADMIN_PASSWORD=Cambiar123
