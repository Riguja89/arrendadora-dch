# Copiar a .env y completar valores locales — NUNCA commitear .env (regla git-safety / DEI).
# Nota: este archivo se llama "env.example" (sin punto inicial) porque los archivos ".env*"
# están bloqueados por permisos de escritura del agente (protección anti-secrets).

# Puerto HTTP de la API
PORT=3000

# Cadena de conexión PostgreSQL (ADR-003)
DATABASE_URL="postgresql://arrendadora:arrendadora@localhost:5432/arrendadora?schema=public"

# Entorno de ejecución
NODE_ENV=development
