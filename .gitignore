# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# IDE artifacts
.idea/
*.swp
*.swo

# Runtime artifacts
__pycache__/
*.pyc
node_modules/
dist/
build/
*.log
*.tsbuildinfo

# Next.js (apps/portal) — next-env.d.ts SÍ se versiona (contenido estándar, permite typecheck
# sin depender de un `next build`/`next dev` previo que lo regenere).
.next/

# Vite (apps/admin)
.vite/

# Prisma — el cliente generado no se versiona (se regenera con `prisma generate`)
generated/prisma/

# Environment variables — NEVER commit
.env
.env.*
.env.local
.env.*.local

# Secrets (safety net — should never be committed)
*.pem
*.key
*.p12
secrets/
credentials/

# Test output
coverage/

# AI tooling — local memory (non-versionable by convention)
.engram/

# Claude Code — local overrides (por convención, no se versionan)
CLAUDE.local.md
.claude/settings.local.json
.claude/agent-memory/

# Promptfoo eval results — locales, el baseline consolidado va en BASELINE-*.md
.claude/evals/.results/

# Plan-gate marker (ORC-010) — efímero, no versionable
.claude/.plan-approved
# Pre-push gate marker (GS-008) — efímero, no versionable
.claude/.prepush-validated
# Zona de artefactos efímeros del flujo ASDD (sofka-asdd-ephemeral-artifacts.md) — no versionable
.tmp/

# ATF Web — corridas efímeras (cada run vive solo en local; regenerable con el pipeline)
docs/testing/atf-web/*/
!docs/testing/atf-web/config/
!docs/testing/atf-web/knowledge/
!docs/testing/atf-web/requirements/
# Playwright CLI — output local
.playwright-cli/

# Smart Data — Excel de trabajo por cliente (ADR-003): contiene datos del cliente,
# no se versiona. La plantilla sanitizada sí se versiona como equivalente-brief.
docs/smart-data/data/*.xlsx
!docs/smart-data/data/smart-data-cliente.xlsx
docs/smart-data/data/~$*.xlsx

# >>> sofka-cli auto-ignore — proprietary template files, do not commit >>>
.mcp.json
.mcp.recommended.json
ASDD-CHANGELOG.md
ASDD-README.md
CLAUDE.md
.claude/
.sofka-asdd/
docs/
.asdd-run.json
ASDD-*
# <<< sofka-cli auto-ignore — do not edit between sentinels <<<
