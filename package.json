{
  "name": "arrendadora",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma web de la inmobiliaria — monorepo (portal, panel admin, API).",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "dev:api": "pnpm --filter @arrendadora/api run dev",
    "dev:portal": "pnpm --filter @arrendadora/portal run dev",
    "dev:admin": "pnpm --filter @arrendadora/admin run dev",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0"
    }
  }
}
